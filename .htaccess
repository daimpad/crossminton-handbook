# Apache-Konfiguration für die Auslieferung auf dem eigenen Server (Plesk/netcup).
#
# WOFÜR: Die App routet über die History API — /baustein/griff ist eine echte
# URL, aber KEINE Datei auf der Platte. Ohne die Regel unten beantwortet Apache
# jeden Deep-Link mit einem 404: geteilte Links, Lesezeichen, Suchtreffer und
# der Googlebot laufen ins Leere. (Ein Besucher, der die Seite schon einmal
# geladen hat, merkt davon nichts — der Service Worker verwirft die 404 zugunsten
# der gecachten Hülle. Genau deshalb fällt der Fehler beim eigenen Testen nicht
# auf, wohl aber jedem Erstbesucher.)
#
# Auf GitHub Pages übernimmt diese Aufgabe 404.html (Pages liest keine .htaccess,
# die Datei ist dort schlicht wirkungslos). Beide Wege bleiben nebeneinander
# bestehen, damit die App unter beiden Auslieferungen funktioniert.
#
# ANNAHME: Die App liegt im Dokumentenstamm der Domain (crossminton-handbook.de),
# passend zu PRAEFIX = '' in index.html/404.html. Läge sie in einem Unterordner,
# müsste RewriteBase entsprechend lauten.

# Kein Schrägstrich-301 für Verzeichnisse. Ohne diese Zeile schickt mod_dir für
# /regeln trotz Regel 1 unten einen 301 auf /regeln/ (die Anfrage zeigt auf das
# Snapshot-Verzeichnis), während das Canonical der Seite auf /regeln zeigt.
# Verlangt AllowOverride Indexes; in der Produktion vorher in rules/.htaccess
# erprobt (/rules: 403 statt 301, kein 500). Verzeichnislisten bleiben aus:
# die Server-Konfiguration hat Indexes abgeschaltet, /images/ antwortet 403.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Unbekannte Adressen bekommen einen echten 404 (Regel 5 unten), ausgeliefert wird
# dabei trotzdem die App-Hülle: Besucher landen in der App statt auf einer nackten
# Serverseite, Suchmaschinen sehen den Status. Vorher kam jede Adresse mit 200 und
# der Startseite zurück — die Search Console meldet das als „Soft 404".
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Eine Adresse je Seite. www.crossminton-handbook.de lieferte die ganze Seite ein
  #    zweites Mal mit Status 200 aus (das Canonical zeigte zwar auf die Hauptadresse,
  #    aber Google musste jede Seite doppelt abrufen, um das zu lernen). Die Query
  #    hängt Apache ungefragt wieder an.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  #    rules/ hält nur die Original-PDFs, ein Verzeichnis ohne Index antwortete mit 403.
  #    Wer es ansteuert, sucht die Turnierstandards — die stehen unter /turnier.
  RewriteRule ^rules/?$ https://%{HTTP_HOST}/turnier [R=301,L]

  # 1. Prerenderter Snapshot zu dieser Route? Direkt ausliefern.
  #    MUSS vor der Verzeichnis-Regel stehen: /baustein/griff IST seit dem
  #    Prerendering ein Verzeichnis, und für Verzeichnisse ohne Schrägstrich
  #    schickt Apache sonst einen 301 auf /baustein/griff/. Das Canonical im
  #    Snapshot zeigt aber auf die Fassung OHNE Schrägstrich — ausgeliefert und
  #    kanonisiert wären dann verschiedene URLs, und genau das soll das
  #    Prerendering ja beheben. Das `!/$` schließt die Wurzel aus.
  #    Allein reicht die Regel nicht: mod_dir schickte den Schrägstrich-301
  #    trotzdem, darum `DirectorySlash Off` oben.
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # 2. Vorhandene Dateien und Verzeichnisse unverändert ausliefern —
  #    JS, CSS, JSON, Schriften, Grafiken, die PDFs unter rules/.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Alles mit Dateiendung ist ein Asset, keine App-Route (die 149 Routen sind
  #    ausnahmslos punktfrei). Fehlt die Datei, soll es ein ehrlicher 404 sein —
  #    nicht die HTML-Hülle mit Status 200, die ein fehlendes Bild verschleiert.
  RewriteRule \.[a-zA-Z0-9]{1,8}$ - [L]

  # 4. App-Routen ohne Snapshot — genau die, die scripts/routen.mjs als CLIENT_ROUTEN
  #    vom Prerendern ausnimmt (ohne gespeicherten Zustand ein leeres Formular), in
  #    jeder Sprache: die Hülle ausliefern, Status 200 unter der ursprünglichen URL —
  #    der Router liest sie beim Boot aus location.pathname. Test [16] hält die Liste
  #    mit CLIENT_ROUTEN deckungsgleich.
  RewriteCond %{REQUEST_URI} ^/(?:(?:en|fr|pl)/)?(?:onboarding|pfad/individual|plan|suche|profil|merkliste|ko-turnier)/?$
  RewriteRule ^ index.html [L]

  # 5. Alles Übrige gibt es nicht: jede gültige Seite hat einen Snapshot (Regel 1) oder
  #    steht in Regel 4. Ein echter 404 — ausgeliefert wird über ErrorDocument oben
  #    trotzdem die Hülle.
  RewriteRule ^ - [R=404,L]
</IfModule>

# Die App arbeitet buildfrei mit STABILEN Dateinamen (kein Content-Hashing).
# Würden Hülle und Service Worker lange zwischengespeichert, bekämen Besucher
# eine neue Fassung erst nach Ablauf der Frist zu sehen. 'no-cache' verbietet
# das Zwischenspeichern nicht, erzwingt aber die Rückfrage beim Server — der
# antwortet bei unveränderter Datei mit 304, kostet also kaum etwas.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Die Grafiken behalten ihren Namen, wenn sie neu gezeichnet werden (G-XXX ist die
  # Identität, nie umbenennen). Ohne Rückfrage sähe ein Besucher die alte Zeichnung,
  # bis der Browser-Cache abläuft. Achtung: In der Produktion liefert nginx statische
  # Dateien direkt aus, dort erreicht diese Regel (wie die für sw.js) niemanden; die
  # Kopfzeile braucht dort eine Plesk-Einstellung (docs/plesk-nginx.md).
  <FilesMatch "^G-\d{3}(\.[a-z]{2})?\.(svg|png)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
